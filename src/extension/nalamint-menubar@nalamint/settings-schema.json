{
  "blur": {
    "type": "switch",
    "default": true,
    "description": "Blur the wallpaper behind panels"
  },
  "blur-radius": {
    "type": "scale",
    "default": 40,
    "min": 4,
    "max": 80,
    "step": 2,
    "description": "Blur strength",
    "dependency": "blur"
  },
  "adaptive-text": {
    "type": "switch",
    "default": true,
    "description": "Dark panel text on bright wallpaper",
    "tooltip": "Measures the wallpaper under each panel and switches its text and icons to dark when it is bright."
  },
  "light-threshold": {
    "type": "scale",
    "default": 0.62,
    "min": 0.3,
    "max": 0.9,
    "step": 0.02,
    "description": "Brightness that counts as bright",
    "dependency": "adaptive-text"
  }
}
